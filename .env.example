# Configuracao da API FastAPI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Configuracao da API do Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.1

# URL da API consumida pelo fluxo no n8n local
API_CLASSIFICACAO_URL=[http://127.0.0.1:8000/api/v1/mensagens/classificar](http://127.0.0.1:8000/api/v1/mensagens/classificar)